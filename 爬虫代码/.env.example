# =========================================================
# NewsCraft 爬虫 .env 示例
# 默认复用项目根目录 .env 的 MYSQL_PASSWORD，
# 如需单独指定连接参数，取消注释并填写：
# =========================================================

# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# MYSQL_PASSWORD=your_mysql_password
# DB_NAME=newscraft_app
# DB_CHARSET=utf8mb4
