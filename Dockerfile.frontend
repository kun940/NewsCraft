# syntax=docker/dockerfile:1

# ============================================================
# NewsCraft 前端镜像（Vue3 + Vite 构建产物，nginx 托管）
#
# 构建（项目根目录执行）：
#   docker build -f Dockerfile.frontend -t newscraft-frontend .
#
# 运行：
#   docker run -p 8080:80 newscraft-frontend
# ============================================================

# ---------- 1. 构建阶段 ----------
FROM node:20-alpine AS builder

WORKDIR /build

# 先拷依赖清单利用缓存
COPY 03-前端项目代码/xwzx-news/package.json 03-前端项目代码/xwzx-news/package-lock.json ./
# 国内构建可取消下一行注释走淘宝源
# RUN npm ci --registry=https://registry.npmmirror.com
RUN npm ci

COPY 03-前端项目代码/xwzx-news/ ./

RUN npm run build

# ---------- 2. 运行阶段 ----------
FROM nginx:alpine AS runtime

# SPA history 路由 + /api 反代到后端容器
# （后端路由前缀均为 /api/...，无需 rewrite）
COPY 03-前端项目代码/xwzx-news/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /build/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
