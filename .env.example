# =========================================================
# NewsCraft 环境变量模板（.env.example）
# 使用：复制为 .env 后填入真实值
#   Windows: Copy-Item .env.example .env
# =========================================================

# 必填项 —— 与 config.yaml 的 ${VAR} 占位符一一对应
MYSQL_PASSWORD=your_mysql_password      # ← database.password
SECRET_KEY=your_random_secret_key       # ← auth.secret_key（Token 签名）
DASHSCOPE_API_KEY=sk-your_key           # ← llm.api_key

# 可选项（留空则用 config.yaml 默认值）
# REDIS_PASSWORD=
# LLM_MODEL=qwen-max
# APP_ENV=dev
# EMBEDDING_MODEL=text-embedding-v3