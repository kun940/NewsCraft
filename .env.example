# =========================================================
# NewsCraft 环境变量模板（.env.example）
# 使用：复制为 .env 后填入真实值
#   Windows: Copy-Item .env.example .env
#
# 注意：本文件只列 key 名，值一律用占位符，不要提交真实密钥。
#       容器化部署时，DATABASE__HOST / REDIS__HOST 等已在
#       docker-compose.yml 里覆盖，这里不用改。
# =========================================================

# ---------- 必填项 ----------
# 与 config.yaml 中的 ${VAR} 占位符一一对应

# MySQL root 密码（对应 database.password）
MYSQL_PASSWORD=your_mysql_password

# Token 签名密钥（对应 auth.secret_key），建议用随机串
#   生成： python -c "import uuid;print(uuid.uuid4().hex)"
SECRET_KEY=your_random_secret_key

# 大模型 API Key（对应 llm.api_key，当前 config.yaml 用的是 DeepSeek）
DEEPSEEK_API_KEY=sk-your_deepseek_key

# ---------- 可选项 ----------

# Redis 密码（对应 redis.password）
# 本机 Redis 未开启 requirepass 时必须留空；若 Redis 设了密码再填
REDIS_PASSWORD=

# Chroma 向量库持久化目录（对应 vector_db.persist_directory）
# 本地开发：指向项目内的 chroma_db 目录
# Docker 部署：docker-compose.yml 已覆盖为 /data/chroma，无需在此设置
CHROMA_PERSIST_DIR=./chroma_db

# ---------- 以下按需取消注释 ----------
# APP__ENV=dev                 # dev / prod
# APP__DEBUG=true
# LLM_MODEL=deepseek-v4-flash
# EMBEDDING_MODEL=bge-m3
